<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_background" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
    <item android:gravity="center_horizontal|bottom" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <size android:height="2dp" android:width="140dp" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
